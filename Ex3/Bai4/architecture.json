  "cards": [
    {
      "dot": "cyan",
      "title": "Đường dữ liệu chính",
      "items": [
        "TIM3 phát TRGO ở 100 Hz; ADC1 lấy một mẫu trên PA0 cho mỗi trigger",
        "DMA vòng lưu đúng 100 mẫu, tương ứng một giây dữ liệu",
        "Mỗi mẫu được gửi dưới dạng số ASCII, phân cách bằng \\n\\r"
      ]
    },
    {
      "dot": "emerald",
      "title": "An toàn hai nửa buffer",
      "items": [
        "Half-transfer công bố mẫu 0–49; Transfer-complete công bố mẫu 50–99",
        "ISR chỉ đặt cờ; main gửi nửa đã hoàn tất trong khi DMA ghi nửa còn lại",
        "50 mẫu tối đa khoảng 312.5 ms ở 9600 baud, nhỏ hơn cửa sổ 500 ms"
      ]
    },
    {
      "dot": "amber",
      "title": "Phụ thuộc và điều chưa biết",
      "items": [
        "Đã biết: STM32F103C8T6, biến trở PA0, USART1 TX PA9, USB–TTL ngoài bo",
        "Chưa xác định: model USB–TTL, cổng thiết bị trên PC và phần mềm terminal",
        "Điện áp hiển thị không nằm trên đường chính; giá trị gửi hiện tại là ADC thô 0–4095"
      ]
    }
  ]
